{
  "formatVersion": 1,
  "id": "org.aimonitor.fixture",
  "name": "Display Fixture",
  "version": "1.0.0",
  "author": "AI Monitor tests",
  "description": "Synthetic data and layouts for testing the display-plugin contract.",
  "viewLabel": "Fixture",
  "attribution": null,
  "minSceneProtocol": 1,
  "source": {
    "url": "https://example.org/api?scale={scale}",
    "intervalSeconds": 900
  },
  "settings": [
    { "key": "label", "label": "Label", "kind": "text", "default": "Demo", "min": null, "max": null },
    { "key": "scale", "label": "Scale", "kind": "number", "default": 1, "min": 0, "max": 100 }
  ],
  "bindings": [
    { "name": "label", "path": "settings.label", "format": "text", "suffix": "", "map": {}, "fallback": "Demo" },
    { "name": "value", "path": "metric.value", "format": "integer", "suffix": " pts", "map": {}, "fallback": "-- pts" },
    { "name": "level", "path": "metric.level", "format": "integer", "suffix": "", "map": {}, "fallback": "0" },
    { "name": "state", "path": "metric.state", "format": "map", "suffix": "", "map": { "0": "Idle", "1": "Active" }, "fallback": "Unknown" }
  ],
  "scenes": {
    "portrait": {
      "background": 1580575,
      "nodes": [
        { "type": "text", "x": 55, "y": 55, "w": 890, "h": 85, "color": 11250603, "font": 20, "text": "{{label}}" },
        { "type": "rect", "x": 55, "y": 151, "w": 890, "h": 3, "color": 3717119 },
        { "type": "circle", "x": 690, "y": 225, "w": 180, "h": 135, "color": 16763745, "visibleWhen": { "binding": "state", "equals": "Active" } },
        { "type": "text", "x": 55, "y": 225, "w": 610, "h": 190, "color": 16777215, "font": 48, "text": "{{value}}" },
        { "type": "text", "x": 55, "y": 430, "w": 890, "h": 90, "color": 11250603, "font": 20, "text": "{{state}}" },
        { "type": "rect", "x": 55, "y": 565, "w": 890, "h": 3, "color": 3717119 },
        { "type": "text", "x": 55, "y": 688, "w": 890, "h": 85, "color": 16777215, "font": 20, "text": "Level {{level}}%" },
        { "type": "bar", "x": 55, "y": 825, "w": 890, "h": 20, "color": 8680559, "trackColor": 3717119, "valueBinding": "level" }
      ]
    },
    "landscape": {
      "background": 1580575,
      "nodes": [
        { "type": "text", "x": 42, "y": 62, "w": 580, "h": 100, "color": 11250603, "font": 20, "text": "{{label}}" },
        { "type": "rect", "x": 42, "y": 176, "w": 915, "h": 4, "color": 3717119 },
        { "type": "circle", "x": 750, "y": 275, "w": 145, "h": 190, "color": 16763745, "visibleWhen": { "binding": "state", "equals": "Active" } },
        { "type": "text", "x": 42, "y": 270, "w": 680, "h": 215, "color": 16777215, "font": 48, "text": "{{value}}" },
        { "type": "text", "x": 42, "y": 525, "w": 700, "h": 95, "color": 11250603, "font": 20, "text": "{{state}}" },
        { "type": "text", "x": 42, "y": 700, "w": 915, "h": 85, "color": 11250603, "font": 16, "text": "Level {{level}}%" },
        { "type": "bar", "x": 42, "y": 848, "w": 915, "h": 22, "color": 8680559, "trackColor": 3717119, "valueBinding": "level" }
      ]
    },
    "square": {
      "background": 1580575,
      "nodes": [
        { "type": "text", "x": 65, "y": 52, "w": 870, "h": 75, "color": 11250603, "font": 24, "text": "{{label}}" },
        { "type": "rect", "x": 65, "y": 147, "w": 870, "h": 3, "color": 3717119 },
        { "type": "circle", "x": 735, "y": 200, "w": 145, "h": 145, "color": 16763745, "visibleWhen": { "binding": "state", "equals": "Active" } },
        { "type": "text", "x": 65, "y": 195, "w": 630, "h": 130, "color": 16777215, "font": 48, "text": "{{value}}" },
        { "type": "text", "x": 65, "y": 355, "w": 870, "h": 75, "color": 11250603, "font": 24, "text": "{{state}}" },
        { "type": "rect", "x": 65, "y": 490, "w": 870, "h": 3, "color": 3717119 },
        { "type": "text", "x": 65, "y": 620, "w": 870, "h": 90, "color": 16777215, "font": 36, "text": "Level {{level}}%" },
        { "type": "bar", "x": 65, "y": 810, "w": 870, "h": 20, "color": 8680559, "trackColor": 3717119, "valueBinding": "level" }
      ]
    }
  }
}
